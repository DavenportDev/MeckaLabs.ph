---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
		<link rel="icon" href="/assets/favicon-white.png" media="(prefers-color-scheme: light)">
    	<link rel="icon" href="/assets/favicon-black.png" media="(prefers-color-scheme: dark)">

    	<!-- Apple Touch Icon -->
    	<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
	</head>
	<body>
		<div class="flex flex-col items-center justify-center">
			<img src="/assets/logo-white.svg" alt="MeckaLabs philippines" class="h-88 w-88">
			<h1><a class="flex items-center text-mlText tracking-tight text-8xl font-semibold" href="https://www.meckalabs.ph">MeckaLabs</a></h1>
			<p class="text-mlText text-xl">Gumagawa kami ng mga solusyon para sa mga Pilipino — coming soon!</p>
			<p class="text-gray-400 text-sm">We’re building solutions for Filipinos — coming soon!</p>
		</div>
		<div class="floating-message text-white px-4 py-2 bg-gray-900 text-right">
			<p>© MeckaLabs 2026, ni Alan Davenport.</p>
			<p class="text-gray-400 text-sm">© MeckaLabs 2026, by Alan Davenport</p>
		</div>
	</body>
</html>